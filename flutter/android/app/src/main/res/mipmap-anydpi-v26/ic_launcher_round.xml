<?xml version="1.0" encoding="utf-8"?>
<!-- Thinking Fish Assist adaptive icon (Android 8+). Layers are rendered by
     tfa/brand/make_icons.py: navy background, the mark as foreground (inside the
     66dp safe zone), and a one-colour mark for Android 13 themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome"/>
</adaptive-icon>
